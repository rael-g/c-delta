<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>cdc</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CDelta.Driver\CDelta.Driver.csproj" />
    <ProjectReference Include="..\..\lib\corelib\CDelta.Corelib.csproj" ReferenceOutputAssembly="false" OutputItemType="CorelibAssembly" />
      <None Include="..\..\lib\std\**\*.cs" CopyToOutputDirectory="PreserveNewest" Link="lib/std/%(RecursiveDir)%(Filename)%(Extension)" />
</ItemGroup>

  <Target Name="CopyCorelib" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <None Include="@(CorelibAssembly)" CopyToOutputDirectory="PreserveNewest" Link="lib/corelib/%(Filename)%(Extension)" />
    </ItemGroup>
  </Target>

</Project>
