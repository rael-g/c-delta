<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CDelta.Driver\CDelta.Driver.csproj" />
    <ProjectReference Include="..\..\lib\corelib\CDelta.Corelib.csproj" ReferenceOutputAssembly="false" OutputItemType="CorelibAssembly" />
    <Compile Include="..\Shared\GoldenFile.cs" Link="GoldenFile.cs" />
  </ItemGroup>

  <Target Name="CopyCorelib" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <None Include="@(CorelibAssembly)" CopyToOutputDirectory="PreserveNewest" Link="lib/corelib/%(Filename)%(Extension)" />
    </ItemGroup>
  </Target>

</Project>
