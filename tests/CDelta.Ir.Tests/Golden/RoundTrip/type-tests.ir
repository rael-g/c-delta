  local %0 x: param T param
  local %1 same: bool temp
  local %2 y: i32 user
bb0:
  %1 = binop eq const comptime.type type param T, const comptime.type type i32  @1:1:3
  branch copy %1 ? bb1 : bb2  @1:1:3
bb1:
